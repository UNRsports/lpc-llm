# --- build ---
/target/
**/*.rs.bk

# --- local model module / engine cache (NEVER push weights) ---
.lpc-llm/
**/blobs/
**/*.gguf
**/*.pack
**/*.pack.json
**/*.pack.partial
**/layers.pack
**/layers.pack.json

# --- synthetic / demo weight files ---
/demo_weights.bin
**/*.bin

# --- local training corpora (private; do not publish) ---
# Canonical private corpora: ~/.local/share/lpc-llm/train (config_lpcllm paths.train_dir).
# data/train/ is gitignored only as a safety net — do not store private data in-repo.
/notes.txt
/data/train/**
!/data/train/.gitkeep
# Accidental in-repo adapter exports (runtime adapters live under XDG data dir)
/adapters/
# Accidental local config copies in the repo root
/config_lpcllm

# --- secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
HF_TOKEN
**/secrets/

# --- toolchain / editor ---
.tools/
.idea/
.vscode/
.rename-tmp/
*.swp
*.swo
*~
.DS_Store

# --- misc ---
*.log
*.tmp
*.partial
